{
  "name": "job-hunt-manager",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build --configLoader runner",
    "lint": "eslint .",
    "test": "vitest --configLoader runner run",
    "test:watch": "vitest --configLoader runner",
    "test:e2e": "playwright test && playwright test --config playwright.google.config.ts",
    "test:collector": "vitest --configLoader runner run src/services/monitoringOnboarding.test.ts src/services/webCollector.test.ts",
    "collector:dry-run": "node tools/web-collector/dry-run.mjs",
    "capture": "playwright test e2e/screenshots.spec.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.57.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@playwright/test": "^1.55.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "eslint": "^9.34.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "jsdom": "^26.1.0",
    "tsx": "4.20.5",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.41.0",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
