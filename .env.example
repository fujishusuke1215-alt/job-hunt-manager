# 明示的なローカル開発モード。開発サーバーでは未指定時もlocalですが、画面に表示されます。
VITE_STORAGE_MODE=local

# Google Drive appDataFolderを本人用保存先にする場合だけ google に変更します。
# VITE_STORAGE_MODE=google
VITE_GOOGLE_CLIENT_ID=

# Production personal mode: Supabase Auth + user_app_data. Publishable key only.
# VITE_STORAGE_MODE=supabase
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Client Secret、access token、passwordは絶対に置かないでください。
